# Copy to .env and adjust for your setup. EXPO_PUBLIC_* vars are inlined
# into the client bundle (there's no server-side secret here, just a URL),
# so this one is safe to commit as an example.

# Defaults (see src/api/client.ts) already handle the two easiest dev
# targets without any .env at all:
#   - Expo web / iOS simulator -> http://localhost:8000/api
#   - Android emulator          -> http://10.0.2.2/api
# Set this explicitly for a physical device (your Mac's LAN IP) or a
# deployed backend.
# EXPO_PUBLIC_API_URL=http://192.168.1.23:8000/api

# Google sign-in (src/auth/google.ts) — one OAuth client ID per platform,
# Google issues a separate one for each. The web app's own Google login
# already has a "Web application" client (backend's GOOGLE_CLIENT_ID) —
# reuse that same value here for Expo web dev/testing. iOS/Android need
# their own dedicated client (type "iOS"/"Android" in Google Cloud
# Console) before a native build can sign in with Google.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=169328165548-srgt8l4hcl3gt1uq7nlkssf13vdk74la.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Over-the-air updates (see app.config.ts). Derived from an absolute
# EXPO_PUBLIC_API_URL when unset; with neither, updates are disabled.
# OTA_UPDATES_URL=https://budget.example.com/api/updates/manifest
