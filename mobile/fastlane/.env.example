# Copy to fastlane/.env (gitignored) — fastlane loads it automatically.

# App Store Connect API key (App Store Connect → Users and Access →
# Integrations → Team Keys, role "App Manager"). Used both to let Xcode
# fetch provisioning profiles and to upload to TestFlight, with no Apple ID
# or 2FA prompt. Without it, signing falls back to the Apple ID signed into
# Xcode and uploads ask for Apple ID credentials.
# ASC_KEY_PATH=/Users/me/.appstoreconnect/AuthKey_XXXXXXXXXX.p8
# ASC_KEY_ID=XXXXXXXXXX
# ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000

# Without an API key: an app-specific password (appleid.apple.com → Sign-In
# and Security → App-Specific Passwords) lets the TestFlight upload skip the
# Apple ID password/2FA prompt.
# FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Overrides (defaults shown).
# FASTLANE_USER=guillaume.bailleul@gmail.com
# APPLE_TEAM_ID=986VZQX8W4
# EXPO_PUBLIC_API_URL=https://lagune.bailleul.dev/api
# IOS_BUILD_NUMBER=<UTC clock, YYYYMMDDHHMM>
# ALLOW_UNSIGNED_OTA=1   # build even without code-signing/certificate.pem
