# Lu par `next build` (donc par `npm run deploy`) : ces valeurs sont figées dans le HTML.
# Copier en .env.production (ignoré par git).
NEXT_PUBLIC_SITE_URL=https://www.example.com
# À renseigner à la publication de l'app (sinon les boutons affichent « Bientôt sur iPhone ») :
# NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/fr/app/id0000000000
# NEXT_PUBLIC_CONTACT_EMAIL=contact@example.com
